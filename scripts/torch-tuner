#!/bin/bash

# Detect install prefix to locate the uninstall script relative to this launcher.
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
INSTALL_PREFIX="$(cd "$SCRIPT_DIR/.." && pwd)"

# Handle `torch-tuner uninstall` → delegate to the bundled uninstall script.
if [[ "${1:-}" == "uninstall" ]]; then
  exec bash "$SCRIPT_DIR/uninstall-torch-tuner.sh"
else
  # Invoke the venv's python interpreter directly. This works regardless of which
  # python (3.10/3.11/3.12) the venv was created from and avoids the cost +
  # subshell side-effects of `source activate`.
  exec "$INSTALL_PREFIX/torch-tuner/.venv/bin/python" "$INSTALL_PREFIX/torch-tuner/src/main/main.py" "$@"
fi